# Porta do servidor
PORT=3000
# Endereço em que a API escuta (127.0.0.1 = só a própria máquina, atrás de um proxy HTTPS)
HOST=
# Arquivo do banco (padrão: backend/database.db)
DB_PATH=

# Chave secreta do JWT (TROQUE em produção!)
JWT_SECRET=troque_isso_por_uma_chave_secreta_bem_grande_e_aleatoria

# Tempo de expiração do token
JWT_EXPIRES_IN=7d

# E-mail (usado no "Esqueci minha senha").
# Sem SMTP_HOST, o código aparece no console do servidor (modo desenvolvimento).
# Exemplo com Gmail: crie uma "senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FinUp <seuemail@gmail.com>"

# ── HTTPS (obrigatório em produção) ─────────────────────────────
# NODE_ENV=production faz a API recusar acessos em HTTP.
# Opção A: a hospedagem/proxy faz o HTTPS (Render, Railway, Nginx…)
#   TRUST_PROXY=1
# Opção B: HTTPS direto no Node, com certificado próprio (ex.: Let's Encrypt)
#   TLS_CERT=/caminho/fullchain.pem
#   TLS_KEY=/caminho/privkey.pem
# Para testar HTTPS localmente: bash scripts/gerar-certificado-dev.sh
#   e use TLS_CERT=certs/dev-cert.pem e TLS_KEY=certs/dev-key.pem
NODE_ENV=development
TRUST_PROXY=
TLS_CERT=
TLS_KEY=

# E-mail exibido na Política de Privacidade (GET /privacidade)
PRIVACIDADE_CONTATO=
